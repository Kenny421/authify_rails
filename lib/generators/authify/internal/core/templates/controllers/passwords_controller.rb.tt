module Authify
  class PasswordsController < ApplicationController
    rate_limit to: 5, within: 1.hour, only: :create,
               unless: -> { Authify.configuration.abuse_mode.to_sym == :enforce },
               with: -> { redirect_to new_password_path, alert: "Too many reset requests. Try again later." }
    rate_limit to: 10, within: 10.minutes, only: :update,
               with: -> { redirect_to new_password_path, alert: "Too many reset attempts. Try again later." }

    def new; end

    def create
      return unless authify_abuse_check(:password_reset, email: params[:email])
      return authify_abuse_challenge if @authify_challenge_required
      user = Authify.user_scope.find_by(email: params[:email].to_s.strip.downcase)
      if user
        token = user.issue_password_reset!
        Authify.configuration.mailer_class.with(user: user, token: token).password_reset.deliver_later
      end
      redirect_to new_password_path, notice: "If an account exists, reset instructions have been sent."
    end

    def edit
      @token = params[:token]
      @user = find_user_by_token(@token)
      redirect_to new_password_path, alert: "That reset link is invalid or expired." unless @user
    end

    def update
      @token = params[:token]
      @user = find_user_by_token(@token)
      return redirect_to(new_password_path, alert: "That reset link is invalid or expired.") unless @user

      updated = false
      @user.with_lock do
        return redirect_to(new_password_path, alert: "That reset link is invalid or expired.") unless @user.password_reset_token_valid?(@token)
        if @user.update(password_params.merge(password_reset_token_digest: nil, password_reset_sent_at: nil, password_changed_at: Time.current))
          @user.authify_sessions.update_all(revoked_at: Time.current)
          Authify::AbuseProtection.new(source: request.remote_ip, account: @user.email, tenant: Current.authify_tenant_id).forget_devices!
          @user.authentication_events.create!(event_type: "password_reset")
          updated = true
        end
      end
      if updated
        if Authify.configuration.email_notifications_enabled && Authify.configuration.password_change_notifications
          Authify.configuration.mailer_class.with(user: @user).password_changed.deliver_later
        end
        redirect_to new_session_path, notice: "Password updated. Please sign in."
      else
        render :edit, status: :unprocessable_entity
      end
    end

    private

    def find_user_by_token(raw)
      user = Authify.user_scope.find_by(password_reset_token_digest: Authify::Token.digest(raw))
      user if user&.password_reset_token_valid?(raw)
    end

    def password_params
      params.require(:user).permit(:password, :password_confirmation)
    end
  end
end
