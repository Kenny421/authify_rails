module Authify
  class PasswordChangesController < ApplicationController
    require_authentication
    rate_limit to: 5, within: 1.hour, only: :update,
               with: -> { redirect_to edit_account_password_path, alert: "Too many password change attempts. Try again later." }

    def edit
      @user = current_user
    end

    def update
      @user = current_user
      unless @user.authenticate(params[:current_password])
        @user.authentication_events.create!(
          event_type: "password_change_failed",
          ip_address: request.remote_ip,
          user_agent: request.user_agent
        )
        return redirect_to edit_account_password_path, alert: "Current password is incorrect."
      end

      attributes = password_params
      if @user.authenticate(attributes[:password])
        @user.errors.add(:password, "must be different from your current password")
        return render :edit, status: :unprocessable_entity
      end

      if @user.update(attributes.merge(password_changed_at: Time.current))
        @user.authify_sessions.update_all(revoked_at: Time.current)
        @user.authentication_events.create!(
          event_type: "password_changed",
          ip_address: request.remote_ip,
          user_agent: request.user_agent
        )
        if Authify.configuration.email_notifications_enabled && Authify.configuration.password_change_notifications
          Authify.configuration.mailer_class.with(user: @user).password_changed.deliver_later
        end
        authify_clear_cookie
        reset_session
        Current.reset
        redirect_to new_session_path, notice: "Password changed. Please sign in again."
      else
        render :edit, status: :unprocessable_entity
      end
    end

    private

    def password_params
      params.require(:user).permit(:password, :password_confirmation)
    end
  end
end
