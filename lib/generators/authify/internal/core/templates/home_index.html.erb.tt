<main class="mx-auto max-w-3xl px-6 py-16 text-center">
  <h1 class="text-4xl font-bold">Welcome</h1>
  <p class="mt-4 text-gray-600">Authentication is ready.</p>

  <div class="mt-8 flex justify-center gap-4">
    <%% if authenticated? %>
      <%%= button_to "Sign out", sign_out_path, method: :delete, class: "rounded bg-black px-5 py-3 text-white" %>
    <%% else %>
      <%%= link_to "Sign in", new_session_path, class: "rounded bg-black px-5 py-3 text-white" %>
      <%%= link_to "Create account", new_registration_path, class: "rounded border px-5 py-3" %>
    <%% end %>
  </div>
</main>
