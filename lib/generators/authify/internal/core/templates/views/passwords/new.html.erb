<div class="mx-auto max-w-md p-6"><h1 class="text-2xl font-bold">Reset password</h1><%= form_with url: passwords_path, class: "mt-6 space-y-4" do |f| %><%= f.email_field :email, required: true, autocomplete: "email", placeholder: "Email", class: "w-full rounded border p-3" %><%= f.submit "Send reset link", class: "w-full rounded bg-black p-3 text-white" %><% end %></div>
