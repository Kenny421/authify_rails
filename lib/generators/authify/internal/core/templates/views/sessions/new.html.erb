<div class="mx-auto max-w-md p-6">
  <h1 class="text-2xl font-bold">Sign in</h1>
  <%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
    <%= render "authify/bot_challenge" %>
    <div><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "email", class: "mt-1 w-full rounded border p-3" %></div>
    <div><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded border p-3" %></div>
    <label class="flex gap-2"><%= check_box_tag :remember_me, "1" %> Remember me</label>
    <%= form.submit "Sign in", class: "w-full rounded bg-black p-3 text-white" %>
  <% end %>
  <div class="mt-4 flex justify-between"><%= link_to "Create account", new_registration_path %><%= link_to "Forgot password?", new_password_path %></div>
</div>
