<div class="mx-auto max-w-md p-6">
  <h1 class="text-2xl font-bold">Create account</h1>
  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
    <%= render "authify/bot_challenge" %>
    <% if @user.errors.any? %><div class="rounded border p-3"><%= @user.errors.full_messages.to_sentence %></div><% end %>
    <div><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "email", class: "mt-1 w-full rounded border p-3" %></div>
    <div><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded border p-3" %></div>
    <p class="text-sm">Use at least <%= Authify.configuration.password_minimum_length %> characters. Known breached passwords are rejected.</p>
    <div><%= form.label :password_confirmation %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-1 w-full rounded border p-3" %></div>
    <%= form.submit "Create account", class: "w-full rounded bg-black p-3 text-white" %>
  <% end %>
</div>
