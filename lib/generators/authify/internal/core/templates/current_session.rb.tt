module Authify
  module CurrentSession
    private

    def authify_resume_session
      raw = cookies.encrypted[:authify_session]
      return if raw.blank?
      record = Authify.configuration.session_class.includes(:user).find_by(token_digest: Authify::Token.digest(raw))
      unless record&.active?
        record.revoke! if record && record.revoked_at.nil?
        authify_clear_cookie
        return
      end
      if Authify.configuration.tenant_enabled && !Authify.user_scope.where(id: record.user_id).exists?
        authify_clear_cookie
        Current.user = Current.authify_session = nil
        return
      end
      if record.user.disabled_at.present? || (Authify.configuration.email_verification_required && !record.user.email_verified?)
        record.revoke!
        authify_clear_cookie
        Current.user = Current.authify_session = nil
        return
      end

      Current.authify_session = record
      Current.user = record.user
      record.update_column(:last_active_at, Time.current) if record.last_active_at < 5.minutes.ago
    end

    def authify_start_session(user, remember: false, authentication_method: "password", expected_version: user.authify_security_version)
      raw, digest = Authify::Token.generate
      duration = remember ? Authify.configuration.remember_me_duration : Authify.configuration.session_absolute_timeout
      record = user.with_lock do
        eligible = user.disabled_at.blank? && !user.locked? && (!Authify.configuration.email_verification_required || user.email_verified?)
        raise Authify::StaleAuthentication unless eligible && user.authify_security_version == expected_version && Authify.user_in_current_tenant?(user)
        user.authify_sessions.create!(
          authify_security_version: expected_version,
          token_digest: digest,
          ip_address: request.remote_ip,
          user_agent: request.user_agent.to_s.first(500),
          authentication_method: authentication_method,
          remembered: remember,
          last_active_at: Time.current,
          expires_at: duration.from_now
        )
      end
      cookies.encrypted[:authify_session] = {
        value: raw, httponly: true, secure: Rails.env.production?, same_site: :lax,
        expires: (remember ? duration.from_now : nil)
      }.compact
      reset_session
      response.headers["X-CSRF-Token"] = form_authenticity_token
      Current.user = user
      Current.authify_session = record
      if Authify.configuration.abuse_mode.to_sym != :off
        device = cookies.encrypted[:authify_device].presence || SecureRandom.urlsafe_base64(32)
        risk = Authify::AbuseProtection.new(source: request.remote_ip, account: user.email, tenant: Current.authify_tenant_id, action: :sign_in)
        risk.succeeded!(device: device)
        cookies.encrypted[:authify_device] = { value: device, httponly: true, secure: Rails.env.production?, same_site: :lax, expires: Authify.configuration.abuse_device_lifetime.from_now }
      end
    end

    def authify_end_session
      Current.authify_session&.revoke!
      authify_clear_cookie
      reset_session
      Current.reset
    end

    def authify_clear_cookie
      cookies.delete(:authify_session)
    end
  end
end
