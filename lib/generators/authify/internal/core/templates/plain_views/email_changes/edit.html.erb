<div>
  <h1>Change email address</h1>
  <p>Your current email remains active until the new address is verified.</p>

  <% if @user.errors.any? %>
    <ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  <% end %>

  <%= form_with model: @user, url: account_email_path, method: :patch do |form| %>
    <%= form.email_field :email, value: @user.pending_email, required: true, autocomplete: "email", placeholder: "New email address" %>
    <%= text_field_tag :code, nil, autocomplete: "one-time-code", placeholder: "Authenticator or recovery code (if enabled)" %>
    <%= password_field_tag :current_password, nil, autocomplete: "current-password", placeholder: "Current password (not needed after recent sudo verification)" %>
    <%= form.submit "Send verification" %>
  <% end %>

  <% if @user.pending_email.present? %>
    <div>
      <p>Pending address: <strong><%= @user.pending_email %></strong></p>
      <p>Requested <%= time_ago_in_words(@user.email_change_sent_at) %> ago.</p>
      <%= form_with url: account_email_path, method: :delete do %>
        <%= text_field_tag :code, nil, autocomplete: "one-time-code", placeholder: "Authenticator or recovery code (if enabled)" %>
    <%= password_field_tag :current_password, nil, autocomplete: "current-password", placeholder: "Current password (not needed after recent sudo verification)" %>
        <%= submit_tag "Cancel email change" %>
      <% end %>
    </div>
  <% end %>
</div>
