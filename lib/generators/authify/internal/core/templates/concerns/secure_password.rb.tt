module Authify
  module SecurePassword
    extend ActiveSupport::Concern

    included do
      has_secure_password
      validates :password,
                length: { minimum: ->(*) { Authify.configuration.password_minimum_length },
                          maximum: ->(*) { Authify.configuration.password_maximum_length } },
                allow_nil: true
      validate :authify_password_not_compromised, if: -> { password.present? && Authify.configuration.pwned_password_check }
    end

    private

    def authify_password_not_compromised
      result = Authify::PasswordBreachChecker.new(password).call
      if result.available && result.breached
        errors.add(:password, "has appeared in a known data breach; choose another password")
      elsif !result.available && Authify.configuration.pwned_fail_closed
        errors.add(:password, "could not be checked securely; try again")
      end
    end
  end
end
