module Authify
  module Authenticatable
    extend ActiveSupport::Concern

    included do
      has_many :authify_sign_in_challenges, foreign_key: :user_id, dependent: :destroy
      has_many :authify_sessions, foreign_key: :user_id, dependent: :destroy
      has_many :authentication_events, foreign_key: :user_id, dependent: :destroy
      normalizes :email, with: ->(value) { value.to_s.strip.downcase }
      validates :email, presence: true
      validates :email, uniqueness: { case_sensitive: false }, unless: -> { Authify.configuration.tenant_enabled }
      validate :authify_tenant_email_available, if: -> { Authify.configuration.tenant_enabled }
      validates :pending_email, format: { with: URI::MailTo::EMAIL_REGEXP }, allow_blank: true
      validates :pending_email, uniqueness: { case_sensitive: false }, allow_blank: true, unless: -> { Authify.configuration.tenant_enabled }
      validate :authify_pending_email_available

      before_create :authify_prepare_email_verification
      around_update :authify_serialize_security_change
    end

    def email_verified?
      email_verified_at.present?
    end

    def locked?
      locked_until.present? && locked_until.future?
    end

    def record_failed_login!
      with_lock do
        next_count = failed_login_attempts.to_i + 1
        attrs = { failed_login_attempts: next_count }
        if Authify.configuration.abuse_mode.to_sym != :enforce && next_count >= Authify.configuration.maximum_login_attempts
          attrs[:locked_until] = Authify.configuration.lockout_duration.from_now
        end
        update_columns(**attrs, updated_at: Time.current)
      end
    end

    def clear_failed_logins!
      update_columns(failed_login_attempts: 0, locked_until: nil, updated_at: Time.current)
    end

    def issue_password_reset!
      with_lock do
        return if password_reset_sent_at && password_reset_sent_at >= 60.seconds.ago
        raw, digest = Authify::Token.generate
        update!(password_reset_token_digest: digest, password_reset_sent_at: Time.current)
        raw
      end
    end

    def password_reset_token_valid?(raw)
      password_reset_sent_at.present? &&
        password_reset_sent_at >= Authify.configuration.password_reset_ttl.ago &&
        Authify::Token.matches?(raw, password_reset_token_digest)
    end

    def issue_email_verification!
      with_lock do
        return if email_verification_sent_at && email_verification_sent_at >= 60.seconds.ago
        raw, digest = Authify::Token.generate
        update!(email_verification_token_digest: digest, email_verification_sent_at: Time.current)
        raw
      end
    end

    # Call under the user lock after changing an enrolled authentication factor.
    def authify_invalidate_credentials!
      with_lock do
        update!(authify_security_version: authify_security_version + 1)
        authify_sessions.where(revoked_at: nil).update_all(revoked_at: Time.current)
      end
    end

    def request_email_change!(new_email)
      normalized = new_email.to_s.strip.downcase
      if normalized.blank? || normalized == email
        errors.add(:pending_email, "must be different from your current email")
        raise ActiveRecord::RecordInvalid, self
      end
      if email_change_sent_at.present? && email_change_sent_at >= Authify.configuration.email_change_request_cooldown.ago
        errors.add(:pending_email, "was requested recently; try again shortly")
        raise ActiveRecord::RecordInvalid, self
      end

      raw, digest = Authify::Token.generate
      update!(
        pending_email: normalized,
        email_change_token_digest: digest,
        email_change_sent_at: Time.current
      )
      raw
    end

    def cancel_email_change!
      update!(
        pending_email: nil,
        email_change_token_digest: nil,
        email_change_sent_at: nil
      )
    end

    def email_change_token_valid?(raw)
      pending_email.present? &&
        email_change_sent_at.present? &&
        email_change_sent_at >= Authify.configuration.email_verification_ttl.ago &&
        Authify::Token.matches?(raw, email_change_token_digest)
    end

    private

    # Serialize credential changes with sign-in completion. A pending first factor,
    # session or API token from an earlier version can never become valid again.
    def authify_serialize_security_change
      sensitive = %w[password_digest email email_verified_at disabled_at]
      if sensitive.any? { |name| will_save_change_to_attribute?(name) }
        self.class.transaction do
          locked = self.class.lock.find(id)
          self.authify_security_version = locked.authify_security_version + 1
          yield
        end
      else
        yield
      end
    end

    def authify_tenant_email_available
      key = Authify.configuration.tenant_key
      errors.add(key, "is required") if self[key].blank?
      scope = self.class.where(key => self[key]).where("LOWER(email) = ?", email.to_s.downcase)
      scope = scope.where.not(id: id) if persisted?
      errors.add(:email, "is already in use") if scope.exists?
    end

    def authify_pending_email_available
      return if pending_email.blank?

      scope = self.class.where("LOWER(email) = ?", pending_email.downcase)
      scope = scope.where(Authify.configuration.tenant_key => self[Authify.configuration.tenant_key]) if Authify.configuration.tenant_enabled
      scope = scope.where.not(id: id) if persisted?
      unavailable = scope.exists?
      if Authify.configuration.tenant_enabled
        pending = self.class.where(Authify.configuration.tenant_key => self[Authify.configuration.tenant_key]).where("LOWER(pending_email) = ?", pending_email.downcase)
        pending = pending.where.not(id: id) if persisted?
        unavailable ||= pending.exists?
      end
      errors.add(:pending_email, "is already in use") if unavailable
    end

    def authify_prepare_email_verification
      return unless Authify.configuration.email_verification_required && !email_verified?
      raw, digest = Authify::Token.generate
      self.email_verification_token_digest = digest
      self.email_verification_sent_at = Time.current
      @authify_initial_verification_token = raw
    end
  end
end
