module Authify
  module Authentication
    extend ActiveSupport::Concern

    included do
      include Authify::CurrentSession
      include Authify::AbuseGuard
      helper_method :current_user, :authenticated?
      before_action :authify_set_tenant
      before_action :authify_resume_session
      rescue_from Authify::MissingTenant, with: -> { head :forbidden }
      class_attribute :authify_public_actions, default: []
    end

    class_methods do
      def require_authentication(**options)
        before_action :authify_require_authentication, **options
      end

      def allow_unauthenticated_access(**options)
        skip_before_action :authify_require_authentication, raise: false, **options
      end
    end

    private

    def authify_set_tenant
      Current.authify_tenant_id = Authify.resolve_tenant(request)
    end

    def current_user
      Current.user
    end

    def authenticated?
      current_user.present?
    end

    def authify_require_authentication
      return if authenticated?
      session[:authify_return_to] = request.fullpath if request.get? || request.head?
      redirect_to new_session_path, alert: "Please sign in to continue."
    end
  end
end
