class AuthifyApiToken < ApplicationRecord
  belongs_to :user, class_name: Authify.configuration.user_class_name

  def self.issue!(user:, name:, scopes: [], expires_at: nil)
    raw, digest = Authify::Token.generate
    version = user.authify_security_version
    token = user.with_lock do
      raise Authify::StaleAuthentication unless user.authify_security_version == version && user.disabled_at.nil?
      create!(authify_security_version: version, user: user, name: name, scopes: scopes, expires_at: expires_at, token_prefix: raw.first(10), token_digest: digest)
    end
    [token, "authify_live_#{raw}"]
  end

  validates :name, presence: true
  validate do
    allowed = Array(Authify.configuration.api_scopes).map(&:to_s)
    errors.add(:scopes, "contains unknown permissions") unless scopes.is_a?(Array) && scopes.all? { |scope| scope.is_a?(String) && allowed.include?(scope) }
  end

  def self.authenticate(bearer)
    return unless bearer.to_s.match?(/\Aauthify_live_[A-Za-z0-9_-]{43}\z/)
    raw = bearer.delete_prefix("authify_live_")
    token = includes(:user).find_by(token_digest: Authify::Token.digest(raw))
    return unless token&.active? && token.user.disabled_at.blank?
    return unless token.scopes.is_a?(Array) && (token.scopes - Array(Authify.configuration.api_scopes).map(&:to_s)).empty?
    return if Authify.configuration.email_verification_required && !token.user.email_verified?
    return if Authify.configuration.tenant_enabled && !Authify.user_scope.where(id: token.user_id).exists?
    token
  end

  def active?
    revoked_at.nil? && authify_security_version == user.authify_security_version && (expires_at.nil? || expires_at.future?)
  end
end
