module Authify
  class SudoController < ApplicationController
    require_authentication
    rate_limit to: 10, within: 5.minutes, only: :create, with: -> { head :too_many_requests }

    def new; end

    def create
      return_to = session[:authify_sudo_return_to]
      if authify_sensitive_authentication(password: params[:password], allow_recent: false)
        Current.authify_session.update!(sudoed_at: Time.current,
          sudo_expires_at: Authify.configuration.sudo_timeout.from_now,
          sudo_method: Current.authify_session.reauthentication_method)
        current_user.authentication_events.create!(event_type: "sudo_entered", ip_address: request.remote_ip, user_agent: request.user_agent)
        redirect_to authify_local_path(return_to, root_path)
      else
        current_user.authentication_events.create!(event_type: "sudo_failed", ip_address: request.remote_ip, user_agent: request.user_agent)
        redirect_to new_sudo_path, alert: "Password or verification code was incorrect, or too many attempts."
      end
    end

    def destroy
      Current.authify_session&.update!(sudoed_at: nil, sudo_expires_at: nil, sudo_method: nil, reauthenticated_at: nil, reauthentication_method: nil)
      redirect_to root_path, notice: "Identity confirmation cleared."
    end
  end
end
