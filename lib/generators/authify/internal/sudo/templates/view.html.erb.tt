<div class="mx-auto max-w-md p-6"><h1 class="text-2xl font-bold">Confirm it is you</h1><%%= form_with url: sudo_path, class: "mt-6 space-y-4" do |f| %><%%= f.password_field :password, required: true, autocomplete: "current-password", class: "w-full rounded border p-3" %><%%= f.text_field :code, autocomplete: "one-time-code", placeholder: "Authenticator or recovery code (if enabled)" %><%%= f.submit "Continue", class: "w-full rounded bg-black p-3 text-white" %><%% end %></div>
