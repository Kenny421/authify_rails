<div class="mx-auto max-w-md p-6">
	<%% if @provisioning_uri.present? %>
		<h1 class="text-2xl font-bold">Set up two-factor authentication</h1>
		<div class="my-6"><%%= @qr_svg %></div>
		<%%= form_with(url: two_factor_path) do |f| %>
      <%%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "Current password" %>
			<%%= f.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", class: "w-full rounded border p-3" %>
			<%%= f.submit "Enable", class: "mt-4 w-full rounded bg-black p-3 text-white" %>
		<%% end %>
	<%% else %>
		<h1 class="text-2xl font-bold">Two-factor authentication is enabled</h1>
		<%% if @recovery_codes.present? %>
			<div class="mt-4 rounded border border-amber-300 bg-amber-50 p-4">
				<h2 class="font-bold">Save these recovery codes now</h2>
				<p class="mt-1 text-sm">Each code works once. They will not be shown again.</p>
				<ul class="mt-3 grid grid-cols-2 gap-2 font-mono"><%% @recovery_codes.each do |code| %><li><%%= code %></li><%% end %></ul>
			</div>
		<%% end %>
		<h2 class="mt-8 font-bold">Generate new recovery codes</h2>
		<%%= form_with(url: recovery_codes_two_factor_path, class: "mt-3 space-y-3") do |f| %>
			<%%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "Current password", class: "w-full rounded border p-3" %>
			<%%= f.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", placeholder: "Authenticator code", class: "w-full rounded border p-3" %>
			<%%= f.submit "Replace recovery codes", class: "w-full rounded border p-3" %>
		<%% end %>
		<p class="mt-2 text-sm text-gray-700">Confirm your password and an authenticator or recovery code to disable two-factor authentication.</p>
		<%%= form_with(url: two_factor_path, method: :delete, class: "mt-6 space-y-4") do |f| %>
			<div><%%= f.label :password, "Current password" %><%%= f.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded border p-3" %></div>
			<div><%%= f.label :code, "Authenticator or recovery code" %><%%= f.text_field :code, required: true, autocomplete: "one-time-code", class: "mt-1 w-full rounded border p-3" %></div>
			<%%= f.submit "Disable two-factor", class: "w-full rounded bg-black p-3 text-white" %>
		<%% end %>
	<%% end %>
</div>
