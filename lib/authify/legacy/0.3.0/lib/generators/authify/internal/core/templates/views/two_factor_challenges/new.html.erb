<div class="mx-auto max-w-md p-6">
  <h1 class="text-2xl font-bold">Two-factor authentication</h1>
  <p class="mt-2 text-gray-600">Enter a code from your authenticator app or a recovery code.</p>
  <%= form_with url: two_factor_challenge_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :code, "Authenticator or recovery code" %>
      <%= form.text_field :code, required: true, autofocus: true, inputmode: "numeric", autocomplete: "one-time-code", class: "mt-1 w-full rounded border p-3" %>
    </div>
    <%= form.submit "Verify and sign in", class: "w-full rounded bg-black p-3 text-white" %>
  <% end %>
</div>
