<div class="mx-auto max-w-3xl p-6"><h1 class="text-2xl font-bold">Your sessions</h1><div class="mt-6 space-y-3"><% @sessions.each do |record| %><div class="rounded border p-4"><p><%= record.user_agent.presence || "Unknown device" %></p><p class="text-sm"><%= record.ip_address %> · <%= record.created_at %></p><%= button_to "Revoke", account_session_path(record), method: :delete, class: "mt-2 underline" unless record.revoked_at %></div><% end %></div></div>
